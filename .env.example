# Knowledge-Shift RAG - Environment Configuration
# Copy this file to .env and fill in your values.

# --- LLM API ---
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-3.5-turbo
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=512

# --- Embedding ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Retriever ---
RETRIEVER_TOP_K=5

# --- Chunker ---
CHUNK_SIZE=200
CHUNK_OVERLAP=30
